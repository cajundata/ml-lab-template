# Copy to .env and fill in. The local train/evaluate lifecycle needs NONE of this —
# credentials are only required for the `make gpu-*` commands.

# --- Reserved: declared for later phases, not read by any code today ---
MLFLOW_TRACKING_URI=./mlruns   # config.py currently pins the store to ./mlruns
DO_API_TOKEN_LOCAL=            # the destroy-scoped token below is the only DO credential in use

# --- GPU: required by every gpu-* command ---
# DO API token with droplet DELETE scope. Powers local teardown AND the in-droplet
# self-destruct timer — it is the only secret ever placed on a droplet.
DO_DROPLET_DESTROY_TOKEN=
# Numeric SSH key IDs or fingerprints (NOT names) from `doctl compute ssh-key list`; comma-separated
DO_SSH_KEY_IDS=
# Local path to the matching PRIVATE key (e.g. ~/.ssh/id_ed25519) — NOT the .pub
DO_SSH_KEY_PATH=

# --- DO Spaces: required by `make gpu-run` only (artifact upload; gpu-up does not need these) ---
SPACES_ACCESS_KEY_ID=
SPACES_SECRET_ACCESS_KEY=
SPACES_BUCKET=                 # bucket must live in the nyc3 region (pinned in gpu/constants.py)
